+ */
+
+package meteordevelopment.meteorclient.mixin;
+
+import com.mojang.renderpearl.backend.api.RenderPassBackend;
+import meteordevelopment.meteorclient.mixininterface.IGpuDevice;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Pseudo;
+import org.spongepowered.asm.mixin.Unique;
+
+/** Supplies Meteor's GUI scissor state for mcopt's optional Metal backend. */
+@Pseudo
+@Mixin(targets = "mcopt.metal.MetalDevice", remap = false)
+public abstract class MetalDeviceMixin implements IGpuDevice {
+    @Unique private int meteor$x, meteor$y, meteor$width, meteor$height;
+    @Unique private boolean meteor$scissorSet;
+
+    @Override
+    public void meteor$pushScissor(int x, int y, int width, int height) {
+        if (meteor$scissorSet) throw new IllegalStateException("Currently there can only be one global scissor pushed");
+
+        meteor$x = x;
+        meteor$y = y;
+        meteor$width = width;
+        meteor$height = height;
+        meteor$scissorSet = true;
+    }
+
+    @Override
+    public void meteor$popScissor() {
+        if (!meteor$scissorSet) throw new IllegalStateException("No scissor pushed");
+
+        meteor$scissorSet = false;
+    }
+
+    @Deprecated
+    @Override
+    public void meteor$onCreateRenderPass(RenderPassBackend backend) {
+        if (meteor$scissorSet) backend.enableScissor(meteor$x, meteor$y, meteor$width, meteor$height);
+    }
+}
